# Copy to .env for local development. Values here are development-only.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://capacity:capacity@localhost:5433/capacity

# Static FX rates, JSON object of "FROM/TO": "rate". Values MUST be strings.
# Each direction is configured explicitly; nothing is derived. Same-currency
# pairs are always 1 and must not be listed.
FX_RATES={"EUR/USD":"1.0800","USD/EUR":"0.9259","GBP/USD":"1.2700","USD/GBP":"0.7874","JPY/USD":"0.0067","USD/JPY":"149.25"}

# Host ports published by docker-compose.yml (override if they collide).
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=29092
APP_HOST_PORT=3000

# Authentication. Development-only values; rotate in any real deployment.
JWT_SECRET=dev-jwt-secret-change-me-please
JWT_EXPIRES_IN=1h
API_CLIENT_ID=demo-client
API_CLIENT_SECRET=demo-client-secret-change-me
